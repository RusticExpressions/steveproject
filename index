* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Jost', sans-serif;
  background: var(--cream);
  color: var(--dark);
  min-height: 100vh;
  overflow-x: hidden;
}

/* ── GRAIN OVERLAY ──────────────────────────────────────── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1000;
  opacity: .4;
}

/* ── HEADER ─────────────────────────────────────────────── */
.header {
  background: var(--caoba);
  padding: 20px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.header-brand {
  font-family: 'Cormorant Garamond', serif;
  font-size: 15px;
  font-weight: 500;
  color: var(--bone);
  letter-spacing: .12em;
  text-transform: uppercase;
}
.header-label {
  font-size: 11px;
  color: rgba(235,230,219,.5);
  letter-spacing: .16em;
  text-transform: uppercase;
}

/* ── HERO ────────────────────────────────────────────────── */
.hero {
  background: var(--caoba);
  min-height: 92vh;
  display: flex;
  align-items: flex-end;
  padding: 0 48px 72px;
  position: relative;
  overflow: hidden;
}

.hero-texture {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 70% 40%, rgba(150,90,50,.25) 0%, transparent 70%),
    radial-gradient(ellipse 60% 80% at 20% 80%, rgba(196,148,58,.1) 0%, transparent 60%);
}

.hero-lines {
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 40px,
      rgba(255,255,255,.015) 40px,
      rgba(255,255,255,.015) 41px
    );
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 780px;
}

.hero-eyebrow {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--gold-light);
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.hero-eyebrow::before {
  content: '';
  width: 40px;
  height: 1px;
  background: var(--gold-light);
  opacity: .6;
}

.hero-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(48px, 7vw, 86px);
  font-weight: 300;
  line-height: 1.0;
  color: var(--bone);
  margin-bottom: 8px;
  letter-spacing: -.02em;
}
.hero-title strong {
  font-weight: 600;
  font-style: italic;
  color: white;
  display: block;
}

.hero-subtitle {
  font-size: 15px;
  font-weight: 300;
  color: rgba(235,230,219,.6);
  margin-top: 20px;
  letter-spacing: .04em;
  max-width: 500px;
  line-height: 1.7;
}

.hero-scroll {
  position: absolute;
  bottom: 36px;
  right: 48px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: rgba(235,230,219,.3);
  font-size: 10px;
  letter-spacing: .16em;
  text-transform: uppercase;
}
.scroll-line {
  width: 1px;
  height: 60px;
  background: linear-gradient(to bottom, rgba(235,230,219,.3), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse {
  0%, 100% { opacity: .3; transform: scaleY(1); }
  50% { opacity: .8; transform: scaleY(1.1); }
}

/* ── SECTIONS ─────────────────────────────────────────────── */
section {
  padding: 96px 48px;
  max-width: 1100px;
  margin: 0 auto;
}
section.full { max-width: 100%; padding: 0; }

/* ── DIVIDER ──────────────────────────────────────────────── */
.ornamental-divider {
  display: flex;
  align-items: center;
  gap: 20px;
  margin: 0 48px;
  padding: 48px 0;
}
.ornamental-divider::before,
.ornamental-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: linear-gradient(to right, transparent, var(--border), transparent);
}
.ornamental-divider span {
  width: 6px;
  height: 6px;
  background: var(--autum);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ── RENDERS SECTION ──────────────────────────────────────── */
.renders-section {
  background: var(--dark);
  padding: 96px 48px;
}
.renders-label {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 20px;
}
.renders-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(36px, 4vw, 52px);
  font-weight: 400;
  color: var(--bone);
  line-height: 1.15;
  margin-bottom: 48px;
  max-width: 600px;
}
.renders-title em { font-style: italic; color: rgba(235,230,219,.6); }

.render-placeholder {
  width: 100%;
  aspect-ratio: 16/9;
  max-width: 900px;
  background: rgba(255,255,255,.04);
  border: 1px dashed rgba(235,230,219,.15);
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  color: rgba(235,230,219,.25);
  font-size: 13px;
  letter-spacing: .08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all .3s;
  overflow: hidden;
  position: relative;
}
.render-placeholder:hover { border-color: rgba(235,230,219,.3); }
.render-placeholder img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
  display: none;
}
.render-placeholder.has-image img { display: block; }
.render-placeholder.has-image .render-placeholder-text { display: none; }
.render-placeholder-icon {
  font-size: 32px;
  opacity: .3;
}

/* ── PACKAGE SECTION ──────────────────────────────────────── */
.package-section {
  background: var(--bone2);
  padding: 96px 48px;
}

.package-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
  margin-top: 48px;
  background: var(--border);
}
.package-cell {
  background: var(--cream);
  padding: 32px 36px;
}
.package-cell.featured {
  background: var(--caoba);
  grid-column: span 2;
}
.cell-label {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--autum);
  margin-bottom: 10px;
}
.cell-label.light { color: rgba(235,230,219,.5); }
.cell-value {
  font-family: 'Cormorant Garamond', serif;
  font-size: 28px;
  font-weight: 500;
  color: var(--dark);
  line-height: 1.2;
}
.cell-value.light { color: var(--bone); font-size: 38px; }
.cell-sub {
  font-size: 13px;
  color: var(--cloudy);
  margin-top: 6px;
  line-height: 1.6;
}
.cell-sub.light { color: rgba(235,230,219,.5); }

.includes-list {
  list-style: none;
  margin-top: 24px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.includes-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13px;
  color: rgba(235,230,219,.75);
  line-height: 1.5;
}
.includes-list li::before {
  content: '✓';
  color: var(--gold-light);
  font-size: 11px;
  margin-top: 2px;
  flex-shrink: 0;
}

/* ── PAYMENT SECTION ──────────────────────────────────────── */
.payment-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2px;
  background: var(--border);
  margin-top: 48px;
}
.payment-block {
  background: var(--cream);
  padding: 36px;
  text-align: center;
}
.payment-block:first-child { background: var(--caoba); }
.pay-pct {
  font-family: 'Cormorant Garamond', serif;
  font-size: 52px;
  font-weight: 300;
  color: var(--dark);
  line-height: 1;
}
.payment-block:first-child .pay-pct { color: var(--bone); }
.pay-label {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
  margin-top: 8px;
  color: var(--cloudy);
}
.payment-block:first-child .pay-label { color: rgba(235,230,219,.6); }
.pay-amount {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px;
  font-weight: 600;
  margin-top: 10px;
  color: var(--dark);
}
.payment-block:first-child .pay-amount { color: white; }
.pay-when {
  font-size: 12px;
  color: var(--cloudy);
  margin-top: 4px;
}
.payment-block:first-child .pay-when { color: rgba(235,230,219,.4); }

/* ── GUARANTEE SECTION ────────────────────────────────────── */
.guarantee-section {
  background: var(--caoba);
  padding: 96px 48px;
  position: relative;
  overflow: hidden;
}
.guarantee-section::before {
  content: '';
  position: absolute;
  top: -100px;
  right: -100px;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(196,148,58,.15) 0%, transparent 70%);
}
.guarantee-content {
  max-width: 700px;
  position: relative;
  z-index: 1;
}
.guarantee-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: rgba(196,148,58,.2);
  border: 1px solid rgba(196,148,58,.3);
  color: var(--gold-light);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .16em;
  text-transform: uppercase;
  padding: 8px 18px;
  border-radius: 2px;
  margin-bottom: 32px;
}
.guarantee-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(36px, 4vw, 58px);
  font-weight: 400;
  color: var(--bone);
  line-height: 1.1;
  margin-bottom: 24px;
}
.guarantee-title strong { font-style: italic; color: white; }
.guarantee-body {
  font-size: 15px;
  font-weight: 300;
  color: rgba(235,230,219,.65);
  line-height: 1.8;
  max-width: 560px;
}

.date-card {
  display: inline-block;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(235,230,219,.15);
  border-radius: 3px;
  padding: 24px 36px;
  margin-top: 40px;
  text-align: center;
}
.date-card-label {
  font-size: 10px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(235,230,219,.4);
  margin-bottom: 8px;
}
.date-card-value {
  font-family: 'Cormorant Garamond', serif;
  font-size: 36px;
  font-weight: 500;
  color: white;
  line-height: 1.1;
}
.date-card-note {
  font-size: 11px;
  color: rgba(235,230,219,.35);
  margin-top: 6px;
}

/* ── URGENCY SECTION ──────────────────────────────────────── */
.urgency-section {
  background: var(--dark);
  padding: 72px 48px;
  display: flex;
  align-items: center;
  gap: 64px;
}
.urgency-left {
  flex: 1;
}
.urgency-right {
  flex-shrink: 0;
  text-align: center;
}
.urgency-label {
  font-size: 11px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--autum);
  margin-bottom: 16px;
}
.urgency-text {
  font-family: 'Cormorant Garamond', serif;
  font-size: 30px;
  font-weight: 400;
  color: var(--bone);
  line-height: 1.35;
}
.urgency-text em { font-style: italic; color: rgba(235,230,219,.5); }
.slots-display {
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(235,230,219,.1);
  border-radius: 3px;
  padding: 28px 40px;
  text-align: center;
}
.slots-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 72px;
  font-weight: 300;
  color: var(--gold-light);
  line-height: 1;
}
.slots-label {
  font-size: 11px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(235,230,219,.35);
  margin-top: 8px;
}

/* ── CTA SECTION ──────────────────────────────────────────── */
.cta-section {
  background: var(--cream);
  padding: 120px 48px;
  text-align: center;
}
.cta-eyebrow {
  font-size: 11px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--autum);
  margin-bottom: 24px;
}
.cta-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(40px, 5vw, 68px);
  font-weight: 400;
  color: var(--caoba);
  line-height: 1.1;
  margin-bottom: 16px;
}
.cta-title em { font-style: italic; }
.cta-sub {
  font-size: 15px;
  font-weight: 300;
  color: var(--cloudy);
  margin-bottom: 52px;
  line-height: 1.7;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
}
.cta-button {
  display: inline-flex;
  align-items: center;
  gap: 16px;
  background: var(--caoba);
  color: var(--bone);
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: .12em;
  text-transform: uppercase;
  padding: 20px 48px;
  border: none;
  cursor: pointer;
  transition: all .3s;
  position: relative;
  overflow: hidden;
}
.cta-button::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--autum);
  transform: translateX(-100%);
  transition: transform .3s;
}
.cta-button:hover::before { transform: translateX(0); }
.cta-button span { position: relative; z-index: 1; }
.cta-arrow {
  position: relative;
  z-index: 1;
  font-size: 18px;
  transition: transform .3s;
}
.cta-button:hover .cta-arrow { transform: translateX(6px); }

.cta-footnote {
  margin-top: 28px;
  font-size: 12px;
  color: rgba(26,10,5,.3);
  letter-spacing: .06em;
}

/* ── FOOTER ───────────────────────────────────────────────── */
.footer {
  background: var(--caoba);
  padding: 32px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.footer-brand {
  font-family: 'Cormorant Garamond', serif;
  font-size: 14px;
  font-weight: 500;
  color: rgba(235,230,219,.6);
  letter-spacing: .1em;
  text-transform: uppercase;
}
.footer-contact {
  font-size: 12px;
  color: rgba(235,230,219,.35);
  letter-spacing: .06em;
}

/* ── SECTION HEADERS ──────────────────────────────────────── */
.section-label {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--autum);
  margin-bottom: 16px;
}
.section-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(32px, 3.5vw, 48px);
  font-weight: 400;
  color: var(--caoba);
  line-height: 1.15;
  margin-bottom: 16px;
}
.section-title em { font-style: italic; color: var(--autum); }
.section-body {
  font-size: 15px;
  font-weight: 300;
  color: var(--cloudy);
  line-height: 1.8;
  max-width: 560px;
}

/* ── ANIMATIONS ────────────────────────────────────────────── */
.fade-up {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity .8s ease, transform .8s ease;
}
.fade-up.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 768px) {
  .hero, section, .renders-section, .package-section,
  .guarantee-section, .urgency-section, .cta-section,
  .footer { padding-left: 24px; padding-right: 24px; }
  .ornamental-divider { margin: 0 24px; }
  .package-grid { grid-template-columns: 1fr; }
  .package-cell.featured { grid-column: span 1; }
  .includes-list { grid-template-columns: 1fr; }
  .payment-row { grid-template-columns: 1fr; }
  .urgency-section { flex-direction: column; gap: 32px; }
  .header { padding: 16px 24px; }
}

/* ── PORTRAIT RENDER OVERRIDE (Steve Ganoe) ─────────────── */
.render-placeholder { aspect-ratio: 896/1200; max-width: 560px; margin: 0 auto; cursor: default; }
.render-placeholder.has-image img { object-fit: cover; }
.render-note {
  max-width: 560px; margin: 18px auto 0; text-align: center;
  font-size: 12px; line-height: 1.55; letter-spacing: .02em;
  color: rgba(235,230,219,.45); font-style: italic;
}

/* ── HERO GLOW (brass/cream) ───────────────────────────── */
.hero-texture {
  background:
    radial-gradient(ellipse 80% 60% at 70% 40%, rgba(169,140,95,.16) 0%, transparent 70%),
    radial-gradient(ellipse 60% 80% at 20% 80%, rgba(243,238,228,.05) 0%, transparent 60%) !important;
}

/* ── JOURNEY / OUR PROCESS ─────────────────────────────── */
.journey-section { background: var(--dark); padding: 104px 48px; }
.journey-head { max-width: 1100px; margin: 0 auto 72px; }
.journey-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--gold); margin-bottom: 18px; }
.journey-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(34px,4.2vw,56px); font-weight: 400; color: var(--bone); line-height: 1.12; max-width: 780px; }
.journey-title em { font-style: italic; color: var(--gold-light); }
.journey-sub { font-size: 15px; font-weight: 300; color: rgba(243,238,228,.55); line-height: 1.75; max-width: 580px; margin-top: 22px; }
.journey-sub em { font-style: italic; color: rgba(243,238,228,.8); }

.journey-steps { max-width: 1100px; margin: 0 auto; }
.jstep { display: grid; grid-template-columns: 1.05fr .95fr; gap: 60px; align-items: center; }
.jstep + .jstep { margin-top: 92px; }
.jstep.reverse .jvisual { order: 2; }
.jstep.reverse .jtext { order: 1; }
.jnum { font-family: 'Cormorant Garamond', serif; font-size: 60px; font-weight: 300; color: var(--gold); line-height: 1; }
.jstep-label { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--gold); margin: 16px 0 12px; }
.jstep-title { font-family: 'Cormorant Garamond', serif; font-size: 30px; font-weight: 400; color: var(--bone); line-height: 1.2; margin-bottom: 14px; }
.jstep-title em { font-style: italic; color: var(--gold-light); }
.jstep-body { font-size: 14.5px; font-weight: 300; color: rgba(243,238,228,.62); line-height: 1.8; }

.jvisual img { width: 100%; display: block; }
.jvisual--plan { background: #fff; padding: 12px; border: 1px solid rgba(243,238,228,.12); border-radius: 3px; box-shadow: 0 20px 50px rgba(0,0,0,.45); }
.jvisual--render { max-width: 430px; margin: 0 auto; border: 1px solid rgba(243,238,228,.12); border-radius: 3px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,.5); }
.jnote { font-size: 11.5px; font-style: italic; color: rgba(243,238,228,.42); line-height: 1.55; margin-top: 16px; }

.jslot { position: relative; aspect-ratio: 1220/726; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; background: rgba(255,255,255,.03); border: 1px dashed rgba(169,140,95,.45); border-radius: 3px; cursor: pointer; color: rgba(243,238,228,.45); text-align: center; padding: 24px; transition: border-color .3s; }
.jslot:hover { border-color: rgba(169,140,95,.75); }
.jslot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: none; }
.jslot.has-image img { display: block; }
.jslot.has-image .jslot-text { display: none; }
.jslot-icon { font-size: 26px; color: var(--gold); opacity: .8; }
.jslot-label { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
.jslot-hint { font-size: 11px; opacity: .55; }

@media (max-width: 768px) {
  .journey-section { padding: 72px 24px; }
  .jstep { grid-template-columns: 1fr; gap: 24px; }
  .jstep + .jstep { margin-top: 56px; }
  .jstep.reverse .jvisual { order: 0; }
  .jstep.reverse .jtext { order: 0; }
}
</style>
</head>
<body>

<!-- HEADER -->
<header class="header">
  <div class="header-brand">Rustic Expressions Furniture ®</div>
  <div class="header-label">Project Proposal</div>
</header>

<!-- HERO -->
<div class="hero">
  <div class="hero-texture"></div>
  <div class="hero-lines"></div>
  <div class="hero-content">
    <div class="hero-eyebrow" id="hero-eyebrow">Your Project Proposal</div>
    <h1 class="hero-title">
      <span id="hero-greeting">Built for</span>
      <strong id="hero-restaurant">Your Restaurant</strong>
    </h1>
    <p class="hero-subtitle" id="hero-subtitle">
      Custom-manufactured to your exact concept. Delivery date in writing. Everything designed for your space.
    </p>
  </div>
  <div class="hero-scroll">
    <div class="scroll-line"></div>
    <span>Scroll</span>
  </div>
</div>

<!-- OUR PROCESS / JOURNEY -->
<div class="journey-section">
  <div class="journey-head fade-up">
    <p class="journey-eyebrow">Our Specialty</p>
    <h2 class="journey-title">We build what you <em>imagine</em> &mdash; from a raw blueprint to the centerpiece of the room.</h2>
    <p class="journey-sub">Every project follows the same path. Here is exactly how <em id="render-restaurant-name">your space</em> goes from an idea on paper to a piece you'll gather around for years.</p>
  </div>

  <div class="journey-steps">

    <!-- Step 01 — the blueprint -->
    <div class="jstep fade-up">
      <div class="jvisual jvisual--plan">
        <img src="data:image/png;base64," alt="Original architectural blueprint of the bar room">
      </div>
      <div class="jtext">
        <div class="jnum">01</div>
        <p class="jstep-label">Where it started</p>
        <h3 class="jstep-title">Your space, <em>on paper</em></h3>
        <p class="jstep-body">It all began right here &mdash; your architect's blueprint: a 21'&times;19' room with a 10' ceiling and the (2)3060 mulled windows on the north wall. Four walls and a vision. This is where we listen, measure, and understand exactly what you want the space to become.</p>
      </div>
    </div>

    <!-- Step 02 — the render -->
    <div class="jstep reverse fade-up">
      <div class="jvisual jvisual--render">
        <img src="data:image/png;base64," alt="Horseshoe saloon bar 3D render">
      </div>
      <div class="jtext">
        <div class="jnum">02</div>
        <p class="jstep-label">The vision, rendered</p>
        <h3 class="jstep-title">See it <em>before</em> we build it</h3>
        <p class="jstep-body">We turn the plan into a photorealistic 3D render &mdash; the horseshoe bar, the columned back bar, the saddle-leather stools and the octagonal poker table &mdash; so you approve every detail before a single board is cut. No surprises. Just your space, brought to life.</p>
        <p class="jnote">Illustrative rendering &mdash; per your direction, the upper section of the back bar is omitted from the final build; shown here for style reference only.</p>
      </div>
    </div>

    <!-- Step 03 — reality -->
    <div class="jstep fade-up">
      <div class="jvisual">
        <div class="jslot" id="reality-slot" onclick="document.getElementById('reality-input').click()">
          <input type="file" id="reality-input" accept="image/*" style="display:none" onchange="loadStep(this)">
          <div class="jslot-text">
            <div class="jslot-icon">&#9670;</div>
            <div class="jslot-label">The finished bar</div>
            <div class="jslot-hint">Final install photo &mdash; click to add on delivery</div>
          </div>
          <img id="reality-img" src="" alt="Finished bar">
        </div>
      </div>
      <div class="jtext">
        <div class="jnum">03</div>
        <p class="jstep-label">It becomes real</p>
        <h3 class="jstep-title">Handcrafted. <em>Delivered. Installed.</em></h3>
        <p class="jstep-body">Master carpenters build your piece by hand in our Texas workshop using solid reclaimed wood, barn wood, and other premium character woods. We deliver and install it in your space &mdash; and the render you approved becomes the room you walk into. That is our specialty: making what our clients imagine real.</p>
      </div>
    </div>

  </div>
</div>

<div class="ornamental-divider"><span></span></div>

<!-- PAYMENT -->
<section>
  <p class="section-label">Investment</p>
  <h2 class="section-title fade-up">Simple, <em>two-stage</em> payment</h2>
  <p class="section-body">Your production slot is reserved the moment the deposit is received. No hidden fees. No surprises.</p>

  <div class="payment-row fade-up">
    <div class="payment-block">
      <div class="pay-pct">50%</div>
      <div class="pay-label">Deposit &mdash; To Begin</div>
      <div class="pay-amount" id="deposit-amount">$0</div>
      <div class="pay-when">Due upon estimate acceptance</div>
    </div>
    <div class="payment-block">
      <div class="pay-pct">50%</div>
      <div class="pay-label">Balance &mdash; Before Shipping</div>
      <div class="pay-amount" id="balance-amount">$0</div>
      <div class="pay-when">Due +8 weeks &middot; before shipping</div>
    </div>
  </div>
</section>

<div class="ornamental-divider"><span></span></div>

<!-- GUARANTEE -->
<div class="guarantee-section">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="guarantee-content fade-up">
      <div class="guarantee-badge">⬡ Contractual Guarantee</div>
      <h2 class="guarantee-title">
        Your delivery date<br>
        <strong>goes in writing.</strong>
      </h2>
      <p class="guarantee-body">
        Not a verbal promise. Not an estimate. A signed legal document with a penalty clause if we miss it. Once you approve your renders, we set the date in the Production Addendum — and that date is ours to honor.
      </p>
      <div class="date-card">
        <div class="date-card-label">Guaranteed Delivery</div>
        <div class="date-card-value" id="delivery-date">September 28, 2026</div>
        <div class="date-card-note">Measured from the day you approve your final design</div>
      </div>
    </div>
  </div>
</div>

<!-- URGENCY -->
<div class="urgency-section">
  <div class="urgency-left fade-up">
    <div class="urgency-label">Production Capacity</div>
    <p class="urgency-text">
      Every contract we sign carries a guaranteed delivery date.<br>
      <em>We can only honor that commitment by controlling how many projects we take on each month.</em>
    </p>
  </div>
  <div class="urgency-right fade-up">
    <div class="slots-display">
      <div class="slots-num" id="slots-num">3</div>
      <div class="slots-label">Slots remaining<br>this month</div>
    </div>
  </div>
</div>

<!-- CTA -->
<div class="cta-section">
  <div class="fade-up">
    <p class="cta-eyebrow">One step away</p>
    <h2 class="cta-title">
      <span id="cta-restaurant-name">Your restaurant</span><br>
      is ready in <em id="cta-opening-date">October 15</em>.
    </h2>
    <p class="cta-sub" id="cta-sub">
      Click below to schedule your project confirmation call with Leo.
      Your production slot is reserved the moment we talk.
    </p>
    <a href="#" class="cta-button" id="cta-link" onclick="window.open('https://links.funnelrocket.io/estimate/6a18c7c321c3b8f644b6a198', '_blank'); return false;">
      <span>Review &amp; Approve Estimate</span>
      <span class="cta-arrow">→</span>
    </a>
    <p class="cta-footnote">
      Prepared exclusively for <span id="cta-client-name">you</span> ·
      Rustic Expressions Furniture ® · El Paso, TX ·
      contact@rusticexpressionstexas.com
    </p>
  </div>
</div>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-brand">Rustic Expressions Furniture ®</div>
  <div class="footer-contact">contact@rusticexpressionstexas.com · El Paso, TX 79928</div>
</footer>

<script>

/* ── Set client data ──────────────────────────────────── */
window.RE = {
  setClient(data) {
    const {
      name = 'there',
      restaurant = 'Your Restaurant',
      city = '',
      concept = '',
      total = '0',
      depositAmount,
      openingDate = '',
      deliveryDate = '',
      slotsLeft = 3,
      calendarUrl = 'https://links.funnelrocket.io/estimate/6a18c7c321c3b8f644b6a198'
    } = data;

    const totalNum = parseFloat(total.replace(/,/g,''));
    const half = (totalNum * 0.5).toLocaleString('en-US', {minimumFractionDigits:0, maximumFractionDigits:0});
    const dep = depositAmount ? depositAmount : half;
    const balance = depositAmount ? (totalNum - parseFloat(String(depositAmount).replace(/,/g,''))).toLocaleString('en-US', {minimumFractionDigits:0, maximumFractionDigits:0}) : half;


    // Hero
    document.getElementById('hero-eyebrow').textContent = `A proposal for ${name}`;
    document.getElementById('hero-greeting').textContent = 'Built for';
    document.getElementById('hero-restaurant').textContent = restaurant;
    document.getElementById('hero-subtitle').textContent =
      `${concept || 'Custom-manufactured to your exact concept'}. Delivery date in writing. Everything designed for your space${city ? ' in ' + city : ''}.`;

    // Renders
    document.getElementById('render-restaurant-name').textContent = restaurant;


    // Payments
    document.getElementById('deposit-amount').textContent = '$' + dep;
    document.getElementById('balance-amount').textContent = '$' + balance;

    // Guarantee
    document.getElementById('delivery-date').textContent = deliveryDate || '—';

    // Urgency
    document.getElementById('slots-num').textContent = slotsLeft;

    // CTA
    document.getElementById('cta-restaurant-name').textContent = restaurant;
    const openMonth = openingDate ? openingDate.split(' ').slice(0,2).join(' ') : 'your opening date';
    document.getElementById('cta-opening-date').textContent = openMonth;
    document.getElementById('cta-sub').textContent =
      `Your build slot is held for ${restaurant}. Review the full estimate and place your deposit below to lock in your delivery date.`;
    document.getElementById('cta-client-name').textContent = name;
    document.getElementById('cta-link').onclick = (e) => {
      e.preventDefault();
      window.open(calendarUrl, '_blank');
    };

    console.log(`✅ Proposal configured for ${name} — ${restaurant}`);
  }
};

/* ── Render upload ────────────────────────────────────── */
function loadRender(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById('render-img').src = e.target.result;
    document.getElementById('render-area').classList.add('has-image');
  };
  reader.readAsDataURL(file);
}

/* ── Reality photo upload ─────────────────────────────── */
function loadStep(input) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    document.getElementById('reality-img').src = e.target.result;
    document.getElementById('reality-slot').classList.add('has-image');
  };
  reader.readAsDataURL(file);
}

/* ── Scroll animations ────────────────────────────────── */
const observer = new IntersectionObserver((entries) => {
  entries.forEach((entry, i) => {
    if (entry.isIntersecting) {
      setTimeout(() => entry.target.classList.add('visible'), i * 120);
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

/* ── DEFAULT DEMO DATA ───────────────────────────────── */
window.RE.setClient({
  name: 'Steve Ganoe',
  restaurant: 'The Horseshoe Saloon',
  city: 'Florida',
  concept: 'Western rustic saloon — horseshoe bar with a columned back bar & octagonal poker table',
  total: '26,996',
  depositAmount: '13,498',          /* Payment 1 of 2 — balance auto = total minus deposit */
  openingDate: '8–12 weeks',     /* timeframe from design approval */
  deliveryDate: '8–12 Weeks',
  slotsLeft: 3,
  calendarUrl: 'https://links.funnelrocket.io/estimate/6a18c7c321c3b8f644b6a198'
});
</script>
</body>
</html>
