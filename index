<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Steve Ganoe — Horseshoe Saloon | Rustic Expressions</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
/* ── VARIABLES ─────────────────────────────────────────── */
:root {
  --caoba: #16130E;        /* near-black (primary dark surfaces) */
  --caoba-light: #221E17;
  --autum: #A98C5F;        /* muted antique brass accent */
  --bone: #F3EEE4;         /* warm cream text on dark */
  --bone2: #FFFFFF;        /* pure white surface */
  --cream: #F6F2EA;        /* warm cream page background */
  --dark: #121009;         /* deep near-black */
  --cloudy: #8E8675;       /* muted taupe-grey secondary text */
  --gold: #A98C5F;         /* brass accent */
  --gold-light: #CBB489;   /* light brass */
  --border: rgba(18,16,9,.12);
}

/* ── EDITOR MODE (Leo fills this in) ───────────────────── */
